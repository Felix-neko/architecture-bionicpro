# Authentik Configuration
AUTHENTIK_SECRET_KEY=change-me-to-a-random-string-at-least-50-chars-long-please
AUTHENTIK_BOOTSTRAP_PASSWORD=admin
AUTHENTIK_BOOTSTRAP_TOKEN=bootstrap-token-change-me
AUTHENTIK_ERROR_REPORTING__ENABLED=false

# Authentik Database
AUTHENTIK_POSTGRESQL__HOST=authentik_db
AUTHENTIK_POSTGRESQL__NAME=authentik
AUTHENTIK_POSTGRESQL__USER=authentik
AUTHENTIK_POSTGRESQL__PASSWORD=authentik_password

# Authentik Redis
AUTHENTIK_REDIS__HOST=authentik_redis

# Keycloak Configuration
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Keycloak Database
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://keycloak_db:5432/keycloak_db
KC_DB_USERNAME=keycloak_user
KC_DB_PASSWORD=keycloak_password

# PostgreSQL (Keycloak)
POSTGRES_DB_KEYCLOAK=keycloak_db
POSTGRES_USER_KEYCLOAK=keycloak_user
POSTGRES_PASSWORD_KEYCLOAK=keycloak_password

# PostgreSQL (Authentik)
POSTGRES_DB_AUTHENTIK=authentik
POSTGRES_USER_AUTHENTIK=authentik
POSTGRES_PASSWORD_AUTHENTIK=authentik_password

# OpenLDAP Configuration
LDAP_ORGANISATION=Zambia Company
LDAP_DOMAIN=zambia.local
LDAP_ADMIN_PASSWORD=admin123
LDAP_TLS=false

# Frontend Configuration
REACT_APP_AUTHENTIK_URL=http://localhost:9000
REACT_APP_CLIENT_ID=bionicpro-frontend
REACT_APP_REDIRECT_URI=http://localhost:5173/callback
REACT_APP_BACKEND_URL=http://localhost:3001

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=3001
KEYCLOAK_ISSUER=http://localhost:8080/realms/reports-realm
KEYCLOAK_JWKS_URL=http://localhost:8080/realms/reports-realm/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=reports-api

# Ports
FRONTEND_PORT=5173
BACKEND_PORT=3001
AUTHENTIK_PORT=9000
AUTHENTIK_HTTPS_PORT=9443
KEYCLOAK_PORT=8080
PHPLDAPADMIN_PORT=8081
POSTGRES_KEYCLOAK_PORT=5433
POSTGRES_AUTHENTIK_PORT=5434
LDAP_PORT=389
